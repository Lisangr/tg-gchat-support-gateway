# Telegram Bot Token (от @BotFather)
TG_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token

# Идентификатор пространства Google Chat (формат: spaces/AAAAxxxxxxx)
GCHAT_SPACE_ID=spaces/AAAAxxxxxxx

# Полное имя Pull-подписки GCP Pub/Sub (для получения ответов операторов из Google Chat)
PUBSUB_SUBSCRIPTION=projects/my-gcp-project/subscriptions/support-gateway-sub

# Путь к JSON-ключу сервисного аккаунта внутри контейнера
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-sa.json

# Путь к локальной SQLite базе для маппинга тредов и дедупликации
DB_PATH=/app/data/gateway.db
