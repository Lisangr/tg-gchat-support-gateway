# Telegram Bot Token (от @BotFather)
TG_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token

# Режим маршрутизации:
# - thread: 1 клиент TG = 1 тред в общем пространстве GCHAT_SPACE_ID (работает везде, вкл. личный Gmail)
# - space:  1 клиент TG = отдельная комната (Space) в Google Chat (требует Google Workspace + Admin Approval)
ROUTING_MODE=thread

# Для режима thread: ID общего пространства операторов (spaces/AAAAxxxxxxx)
GCHAT_SPACE_ID=spaces/AAAAxxxxxxx

# Для режима space: ID клиента Workspace (обычно customers/my_customer) и email операторов через запятую
GCHAT_CUSTOMER=customers/my_customer
GCHAT_OPERATOR_EMAILS=support1@company.com,support2@company.com

# Полное имя Pull-подписки GCP Pub/Sub
PUBSUB_SUBSCRIPTION=projects/my-gcp-project/subscriptions/support-gateway-sub

# Путь к JSON-ключу сервисного аккаунта внутри контейнера
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-sa.json

# Путь к локальной SQLite базе
DB_PATH=/app/data/gateway.db

LOG_LEVEL=INFO
METRICS_PORT=9090